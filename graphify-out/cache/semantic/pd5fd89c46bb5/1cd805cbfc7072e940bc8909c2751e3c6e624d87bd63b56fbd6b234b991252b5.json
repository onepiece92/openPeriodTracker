{"nodes": [{"id": "fastlane_metadata_en_us_description_app_store_description", "label": "App Store description (TRACK / PREDICT / UNDERSTAND / PRIVATE BY DESIGN / OPEN SOURCE)", "file_type": "document", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opens with three FAQ lines (offline? account? cost?) to answer the objections of privacy-minded users before listing features."}, {"id": "fastlane_metadata_en_us_description_private_by_design", "label": "Private by Design", "file_type": "rationale", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Health data stays in a local on-device database: no account, no cloud, no analytics, no advertising SDKs. Backup/restore is a user-controlled JSON file, location is optional and used only to choose a food region, and AI summaries can be routed to the user's own Ollama server instead of a hosted service. Positioned as the reason to pick this tracker over ones that collect health data."}, {"id": "fastlane_metadata_en_us_description_on_device_prediction_model", "label": "On-device prediction model (cycle length and period duration)", "file_type": "concept", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Predicts next period, fertile window and peak day, refining cycle length and period duration from the user's own history without leaving the device."}, {"id": "fastlane_metadata_en_us_description_phase_and_symptom_forecast", "label": "7-day phase forecast and symptom forecast", "file_type": "concept", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fastlane_metadata_en_us_description_period_reminders", "label": "Optional reminders before a predicted period", "file_type": "concept", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fastlane_metadata_en_us_description_doctors_checklist", "label": "Doctor's checklist (pain, discharge, skin, hair, sleep, libido, digestion, breast changes, energy, weight)", "file_type": "concept", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fastlane_metadata_en_us_description_insights_and_analytics", "label": "Insights and Analytics (best/worst cycle days, logging score, trends, phase correlations)", "file_type": "concept", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fastlane_metadata_en_us_description_diet_and_nutrition", "label": "Diet & Nutrition (phase-aware foods, macros, hydration, supplements, regional picks)", "file_type": "concept", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regional food picks only appear if the user chooses to share location; location is used for nothing else."}, {"id": "fastlane_metadata_en_us_description_yoga", "label": "Yoga (poses and breathwork matched to cycle phase)", "file_type": "concept", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fastlane_metadata_en_us_description_ai_prompt_builder", "label": "AI prompt builder (anonymised log summary for ChatGPT, Claude or Gemini)", "file_type": "concept", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instead of calling an AI service itself, the app builds an anonymised summary the user pastes into a chatbot of their choice, keeping the app free of network calls and account requirements."}, {"id": "fastlane_metadata_en_us_description_json_backup_restore", "label": "JSON backup and restore", "file_type": "concept", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plain JSON file the user controls replaces cloud sync, so data portability does not require an account."}, {"id": "fastlane_metadata_en_us_description_ollama_local_ai", "label": "Optional self-hosted Ollama server for local AI summaries", "file_type": "concept", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fastlane_metadata_en_us_description_open_source_mit_license", "label": "Open source under MIT license (github.com/onepiece92/openPeriodTracker)", "file_type": "concept", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Publishing the full source lets users read and audit the privacy claims rather than trust them."}, {"id": "fastlane_metadata_en_us_description_medical_disclaimer", "label": "Not a medical device disclaimer", "file_type": "concept", "source_file": "fastlane/metadata/en-US/description.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "fastlane_metadata_en_us_description_app_store_description", "target": "fastlane_metadata_en_us_description_private_by_design", "relation": "references", "c