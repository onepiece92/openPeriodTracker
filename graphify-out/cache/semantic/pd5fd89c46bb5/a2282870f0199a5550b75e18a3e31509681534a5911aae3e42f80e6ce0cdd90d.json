{"nodes": [{"id": "readme_open_period_tracker", "label": "Open Period Tracker (app)", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_privacy_first_architecture", "label": "Privacy-first, offline, local-only architecture", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Works offline, needs no account, shows no ads, keeps data on the device. The app runs no servers and collects nothing: no cloud sync, no analytics SDK, no advertising SDK. Contributions must keep the app offline-first and free of tracking."}, {"id": "readme_lstm_prediction_model", "label": "On-device LSTM prediction model (TensorFlow Lite)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small LSTM trained by scripts/train_lstm_model.py and run via tflite_flutter refines cycle length and period duration predictions from the user's own history, without any network."}, {"id": "readme_json_backup_restore", "label": "JSON backup and restore", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_feature_first_architecture", "label": "Feature-first architecture (lib/features, lib/core)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "lib/features/<feature>/ holds screens; lib/core/ holds models, providers, database and theme. CHANGELOG 1.0.0 lists it as chosen for scalability."}, {"id": "readme_optional_network_uses", "label": "Three optional network uses (YouTube, OS geocoder, Ollama)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Network use is limited to three opt-in things: opening YouTube links from the Yoga tab, the OS geocoder to pick a food region (only if location is granted), and a user-configured Ollama server for local AI summaries."}, {"id": "readme_tech_stack", "label": "Tech stack (Flutter 3, provider, sqflite, go_router, tflite_flutter, Google Fonts)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_brand_builder", "label": "Brand Builder (developer)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ai_prompt_builder", "label": "AI prompt builder (anonymised summary for ChatGPT/Claude/Gemini)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_doctors_checklist", "label": "Doctor's checklist", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_diet_nutrition", "label": "Diet & Nutrition (phase-aware foods, regional picks)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_yoga_tab", "label": "Yoga tab (phase-matched poses, breathwork, YouTube links)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_demo_data_generator", "label": "Demo data generator (one year of realistic data)", "file_type": "concept", "source