{"nodes": [{"id": "fastlane_howto_store_metadata_guide", "label": "Store Metadata Guide (fastlane HOWTO)", "file_type": "document", "source_file": "fastlane/HOWTO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both store listings are kept in the fastlane metadata layout so a listing update is a single command instead of a copy-paste session in two web consoles. en-US/ feeds App Store (deliver); android/en-US/ feeds Google Play (supply) and F-Droid."}, {"id": "fastlane_howto_deliver", "label": "fastlane deliver (App Store listing upload)", "file_type": "concept", "source_file": "fastlane/HOWTO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run with --skip_binary_upload --skip_screenshots because binaries ship separately and screenshots are not yet arranged per device size; --skip_metadata false --screenshots_path is added once fastlane/screenshots/en-US/ exists with device-size names in the file names."}, {"id": "fastlane_howto_supply", "label": "fastlane supply (Google Play listing upload)", "file_type": "concept", "source_file": "fastlane/HOWTO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run with --skip_upload_apk/aab/images/screenshots so only listing text is pushed; requires a Play Console service-account JSON passed via --json_key."}, {"id": "fastlane_howto_character_limits", "label": "Store listing character limits", "file_type": "concept", "source_file": "fastlane/HOWTO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-field store limits documented so edits stay accepted: name/subtitle/title 30 chars, keywords 100 bytes, promotional text 170, Play short description 80, both long descriptions 4000."}, {"id": "fastlane_howto_manual_app_store_connect_fields", "label": "Hand-set App Store Connect fields", "file_type": "concept", "source_file": "fastlane/HOWTO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "deliver cannot change primary category (Health & Fitness), secondary category (Medical) or the age-rating questionnaire (target 12+), so these are set manually in App Store Connect."}, {"id": "fastlane_howto_app_identifier", "label": "App identifier com.brandbuilder.periodtracker", "file_type": "concept", "source_file": "fastlane/HOWTO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fastlane_howto_screenshots_folder", "label": "docs/assets/screenshots shared screenshot folder", "file_type": "concept", "source_file": "fastlane/HOWTO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One folder feeds both store listings and the website; deliver needs them rearranged into fastlane/screenshots/en-US/ with device-size file names before screenshot upload is enabled."}], "edges": [{"source": "fastlane_howto_store_metadata_guide", "target": "fastlane_howto_deliver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fastlane/HOWTO.md", "source_location": null, "weight": 1.0}, {"source": "fastlane_howto_store_metadata_guide", "target": "fastlane_howto_supply", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fastlane/HOWTO.md", "source_location": null, "weight": 1.0}, {"source": "fastlane_howto_store_metadata_guide", "target": "fastlane_howto_character_limits", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "fastlane/HOWTO.md", "source_location": null, "weight": 1.0}, {"source": "fastlane_howto_store_metadata_guide", "target": "fastlane_howto_manual_app_store_connect_fields", "relation": "ref